{
  "format_version": 1,
  "recipe_version": 1,
  "id": "compat.curves.v1",
  "display": {"name": "Curves", "summary": "Composable compatibility curve and motif definition."},
  "family": "structured-fields",
  "outputs": ["paths"],
  "parameters": [
    {"key":"output-width","label":"Output Width","help":"Curve artboard width.","scope":"pattern","value_type":"integer","default":{"kind":"integer","value":900},"constraints":{"kind":"integer","minimum":1,"maximum":100000,"step":1},"choices":[]},
    {"key":"output-height","label":"Output Height","help":"Curve artboard height.","scope":"pattern","value_type":"integer","default":{"kind":"integer","value":620},"constraints":{"kind":"integer","minimum":1,"maximum":100000,"step":1},"choices":[]},
    {"key":"long-edge-cells","label":"Grid Density","help":"Long edge grid cells.","scope":"pattern","value_type":"number","default":{"kind":"number","value":90.0},"constraints":{"kind":"number","minimum":2.0,"maximum":10000.0,"step":0.001},"choices":[]},
    {"key":"min-mark","label":"Minimum Width","help":"Minimum curve width response.","scope":"pattern","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":0.0,"maximum":1000.0,"step":0.001},"choices":[]},
    {"key":"max-mark","label":"Maximum Width","help":"Maximum curve width response.","scope":"pattern","value_type":"number","default":{"kind":"number","value":85.0},"constraints":{"kind":"number","minimum":0.0,"maximum":1000.0,"step":0.001},"choices":[]},
    {"key":"layout","label":"Layout","help":"Full width or repeated motif layout.","scope":"pattern","value_type":"choice","default":{"kind":"choice","value":"full-width"},"constraints":{"kind":"choice"},"choices":["full-width","motif-pattern"]},
    {"key":"use-shared-curve","label":"Shared Curve","help":"Use the shared editable curve path.","scope":"pattern","value_type":"boolean","default":{"kind":"boolean","value":true},"constraints":{"kind":"boolean"},"choices":[]},
    {"key":"shared-path","label":"Shared Path","help":"Digest identified editable curve path.","scope":"pattern","value_type":"svg-asset","default":{"kind":"svg-asset","value":"sha256:b9d5b65f6d2324bc6ec77e9c3e1d82cdb212afb934b341e2d16a41bc2763da0d"},"constraints":{"kind":"svg-asset"},"choices":[]},
    {"key":"shared-close-ends","label":"Close Shared Ends","help":"Close the shared path ends.","scope":"pattern","value_type":"boolean","default":{"kind":"boolean","value":false},"constraints":{"kind":"boolean"},"choices":[]},
    {"key":"shared-smooth-join","label":"Smooth Shared Join","help":"Smooth shared joins.","scope":"pattern","value_type":"boolean","default":{"kind":"boolean","value":false},"constraints":{"kind":"boolean"},"choices":[]},
    {"key":"enabled","label":"Enabled","help":"Emit semantic channel.","scope":"output-channel","value_type":"boolean","default":{"kind":"boolean","value":true},"constraints":{"kind":"boolean"},"choices":[]},
    {"key":"color","label":"Color","help":"Channel color.","scope":"output-channel","value_type":"text","default":{"kind":"text","value":"#111111"},"constraints":{"kind":"text","max_length":7},"choices":[]},
    {"key":"grid-rotation","label":"Grid Rotation","help":"Placement rotation.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.000001},"choices":[]},
    {"key":"grid-pivot-x","label":"Grid Pivot X","help":"Placement pivot X.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.000001},"choices":[]},
    {"key":"grid-pivot-y","label":"Grid Pivot Y","help":"Placement pivot Y.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.000001},"choices":[]},
    {"key":"resolution-scale","label":"Resolution","help":"Positive placement resolution.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":1.0},"constraints":{"kind":"number","minimum":0.0,"maximum":100.0,"step":0.000001},"choices":[]},
    {"key":"offset-x","label":"Offset X","help":"Placement phase X.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.000001},"choices":[]},
    {"key":"offset-y","label":"Offset Y","help":"Placement phase Y.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.000001},"choices":[]},
    {"key":"path","label":"Path","help":"Digest identified channel curve path.","scope":"output-channel","value_type":"svg-asset","default":{"kind":"svg-asset","value":"sha256:b9d5b65f6d2324bc6ec77e9c3e1d82cdb212afb934b341e2d16a41bc2763da0d"},"constraints":{"kind":"svg-asset"},"choices":[]},
    {"key":"close-ends","label":"Close Ends","help":"Close channel ends.","scope":"output-channel","value_type":"boolean","default":{"kind":"boolean","value":false},"constraints":{"kind":"boolean"},"choices":[]},
    {"key":"smooth-join","label":"Smooth Join","help":"Smooth channel join.","scope":"output-channel","value_type":"boolean","default":{"kind":"boolean","value":false},"constraints":{"kind":"boolean"},"choices":[]},
    {"key":"curve-scale","label":"Curve Scale","help":"Motif scale.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":32.0},"constraints":{"kind":"number","minimum":0.1,"maximum":500.0,"step":0.001},"choices":[]},
    {"key":"motif-coverage","label":"Motif Coverage","help":"Automatic or manual motif coverage.","scope":"output-channel","value_type":"choice","default":{"kind":"choice","value":"auto"},"constraints":{"kind":"choice"},"choices":["auto","manual"]},
    {"key":"motif-bleed","label":"Motif Bleed","help":"Motif edge bleed.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":2.0},"constraints":{"kind":"number","minimum":0.0,"maximum":100.0,"step":0.001},"choices":[]},
    {"key":"tile-count","label":"Tile Count","help":"Repeated motif tiles.","scope":"output-channel","value_type":"integer","default":{"kind":"integer","value":2},"constraints":{"kind":"integer","minimum":1,"maximum":10000,"step":1},"choices":[]},
    {"key":"tile-angle","label":"Tile Angle","help":"Motif tile rotation.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.000001},"choices":[]},
    {"key":"tile-offset","label":"Tile Offset","help":"Motif tile phase.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.001},"choices":[]},
