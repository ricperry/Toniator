    {"key":"stack-offset","label":"Stack Offset","help":"Motif stack offset.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.001},"choices":[]},
    {"key":"alternate-stack-offset","label":"Alternate Stack Offset","help":"Alternating stack offset.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.0},"constraints":{"kind":"number","minimum":-1.7976931348623157e308,"maximum":1.7976931348623157e308,"step":0.001},"choices":[]},
    {"key":"alternate-tile-transform","label":"Alternate Tile Transform","help":"Alternating tile transform.","scope":"output-channel","value_type":"choice","default":{"kind":"choice","value":"none"},"constraints":{"kind":"choice"},"choices":["none","flip","rotate-180"]},
    {"key":"scale","label":"Scale","help":"Width scale.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":1.0},"constraints":{"kind":"number","minimum":0.0,"maximum":100.0,"step":0.000001},"choices":[]},
    {"key":"threshold","label":"Threshold","help":"Source threshold.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":0.04},"constraints":{"kind":"number","minimum":0.0,"maximum":1.0,"step":0.000001},"choices":[]},
    {"key":"max-size","label":"Maximum Size","help":"Channel maximum response.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":100.0},"constraints":{"kind":"number","minimum":0.0,"maximum":10000.0,"step":0.001},"choices":[]},
    {"key":"output-quality","label":"Output Quality","help":"Positive path sampling quality.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":1.0},"constraints":{"kind":"number","minimum":0.0,"maximum":100.0,"step":0.000001},"choices":[]},
