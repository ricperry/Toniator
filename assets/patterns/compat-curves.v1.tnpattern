    {"key":"stack-spacing","label":"Stack Spacing","help":"Motif stack spacing.","scope":"output-channel","value_type":"number","default":{"kind":"number","value":36.0},"constraints":{"kind":"number","minimum":-10000.0,"maximum":10000.0,"step":0.001},"choices":[]},
