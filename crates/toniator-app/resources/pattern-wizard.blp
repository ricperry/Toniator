using Gtk 4.0;

template $ToniatorPatternWizardShell : Gtk.Box {
  orientation: vertical;
  spacing: 12;
  vexpand: true;
  margin-top: 12;
  margin-bottom: 12;
  margin-start: 12;
  margin-end: 12;

  Gtk.Label wizard_breadcrumb {
    xalign: 0;
    wrap: true;
    styles [ "heading" ]
  }

  Gtk.Label wizard_status {
    label: "Choose a pattern. Nothing changes until Apply.";
    xalign: 0;
    wrap: true;
    styles [ "dim-label" ]
  }

  Gtk.Box wizard_layout {
    orientation: horizontal;
    spacing: 16;
    hexpand: true;
    vexpand: true;

    Gtk.ScrolledWindow wizard_gallery_panel {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;
      hexpand: true;
      vexpand: true;
      min-content-width: 300;
      min-content-height: 300;

      Gtk.Box wizard_gallery {
        orientation: vertical;
        spacing: 10;
        valign: start;

        Gtk.Label wizard_gallery_heading {
          label: "Pattern Gallery";
          xalign: 0;
          styles [ "heading" ]
        }

        Gtk.Label wizard_gallery_instruction {
          label: "Choose a Pattern. Use as is applies it to your document. Customize walks through its layout and drawing settings. Create new starts with a fresh layout.";
          xalign: 0;
          wrap: true;
          styles [ "dim-label" ]
        }

        Gtk.FlowBox wizard_cards {
          selection-mode: none;
          row-spacing: 10;
          column-spacing: 10;
          max-children-per-line: 3;
          min-children-per-line: 1;
          hexpand: true;
          valign: start;
        }
      }
    }

    Gtk.Box wizard_page_panel {
      orientation: vertical;
      spacing: 10;
      hexpand: true;
      vexpand: true;
      width-request: 300;

      Gtk.ScrolledWindow wizard_preview_viewport {
        height-request: 200;
        min-content-height: 200;
        max-content-height: 200;
        hscrollbar-policy: never;
        vscrollbar-policy: never;
        propagate-natural-height: false;
        hexpand: true;
        vexpand: false;

        Gtk.Overlay wizard_preview_frame {
          hexpand: true;
          vexpand: false;

          Gtk.Picture wizard_preview {
            content-fit: contain;
            can-shrink: true;
            hexpand: true;
            vexpand: false;
            styles [ "toniator-wizard-preview" ]
          }

          [overlay]
          Gtk.Spinner wizard_spinner {
            visible: false;
            halign: center;
            valign: center;
            tooltip-text: "Preview updating";
          }
        }
      }

      Gtk.ScrolledWindow wizard_controls_scroll {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        hexpand: true;
        vexpand: true;
        min-content-height: 220;

        Gtk.Box wizard_controls {
          orientation: vertical;
          spacing: 10;
          valign: start;
        }
      }
    }
  }

  Gtk.Box wizard_actions {
    orientation: horizontal;
    spacing: 8;
    halign: end;
  }
}
