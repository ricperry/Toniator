using Gtk 4.0;

template $ToniatorPatternWizardCard : Gtk.Box {
  orientation: vertical;
  spacing: 6;
  width-request: 220;
  styles [ "toniator-wizard-card" ]

  Gtk.Image wizard_card_thumbnail {
    pixel-size: 96;
    halign: start;
  }

  Gtk.Label wizard_card_name {
    xalign: 0;
    wrap: true;
    max-width-chars: 28;
    styles [ "heading" ]
  }

  Gtk.Label wizard_card_category {
    xalign: 0;
    wrap: true;
    max-width-chars: 28;
    styles [ "dim-label" ]
  }

  Gtk.Label wizard_card_current_candidate {
    label: "Current candidate";
    visible: false;
    xalign: 0;
    styles [ "toniator-wizard-card-badge" ]
  }

  Gtk.Label wizard_card_description {
    xalign: 0;
    wrap: true;
    max-width-chars: 28;
    styles [ "dim-label" ]
  }

  Gtk.Label wizard_card_unavailable {
    visible: false;
    xalign: 0;
    wrap: true;
    max-width-chars: 28;
    styles [ "dim-label" ]
  }

}
