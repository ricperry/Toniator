using Gtk 4.0;

template $ToniatorMainShell : Gtk.Box {
  orientation: vertical;
  vexpand: true;

  Gtk.HeaderBar header {
    [start]
    Gtk.Box {
      spacing: 0;
      styles [ "linked" ]
      Gtk.Button new_primary {
        label: "_New";
        use-underline: true;
        action-name: "app.new";
        tooltip-text: "New document (Ctrl+N)";
      }
      Gtk.MenuButton new_button {
        icon-name: "pan-down-symbolic";
        tooltip-text: "Open artwork, import a sequence, or use document Presets";
        accessibility { label: "New options"; }
      }
    }
    [start]
    Gtk.Button undo_button {
      icon-name: "edit-undo-symbolic";
      action-name: "app.undo";
      tooltip-text: "Undo the last change (Ctrl+Z)";
      accessibility { label: "Undo"; }
    }
    [start]
    Gtk.Button redo_button {
      icon-name: "edit-redo-symbolic";
      action-name: "app.redo";
      tooltip-text: "Redo the last change (Ctrl+Shift+Z)";
      accessibility { label: "Redo"; }
    }
    [title]
    Gtk.Box {
      orientation: vertical;
      spacing: 0;
      Gtk.Label window_title {
        label: "Welcome";
        ellipsize: middle;
        styles [ "title" ]
      }
      Gtk.Label {
        label: "Toniator";
        styles [ "caption", "dim-label" ]
      }
    }
    [end]
    Gtk.MenuButton file_button {
      icon-name: "open-menu-symbolic";
      tooltip-text: "Main Menu";
      accessibility { label: "Main Menu"; }
    }
    [end]
    Gtk.ToggleButton channel_settings_drawer {
      icon-name: "sidebar-show-symbolic";
      active: true;
      tooltip-text: "Show or hide Settings";
      accessibility { label: "Settings"; }
    }
  }

  Gtk.Box workspace_split {
    orientation: horizontal;
    vexpand: true;
    accessibility { label: "Canvas and Settings"; }

    Gtk.Box canvas_column {
      orientation: vertical;
      hexpand: true;
      vexpand: true;

      Gtk.Stack page_stack {
        transition-type: crossfade;
        hexpand: true;
        vexpand: true;

        Gtk.StackPage {
          name: "empty";
          child: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            valign: center;
            halign: center;
            Gtk.Image { icon-name: "image-x-generic-symbolic"; pixel-size: 48; }
            Gtk.Label {
              label: "Create a document or open artwork.";
              wrap: true;
              styles [ "title-3" ]
            }
            Gtk.Button {
              label: "_Open artwork…";
              use-underline: true;
              action-name: "app.open";
              halign: center;
              tooltip-text: "Open artwork or a document (Ctrl+O)";
            }
          };
        }
        Gtk.StackPage {
          name: "loading";
          child: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            valign: center;
            halign: center;
            Gtk.Spinner { spinning: true; }
            Gtk.Label { label: "Working…"; }
          };
        }
        Gtk.StackPage {
          name: "error";
          child: Gtk.Box {
            orientation: vertical;
            valign: center;
            halign: center;
            Gtk.Label error_label {
              max-width-chars: 70;
              justify: center;
              wrap: true;
            }
          };
        }
        Gtk.StackPage {
          name: "success";
          child: Gtk.Overlay viewer {
            hexpand: true;
            vexpand: true;
            styles [ "toniator-viewer", "toniator-viewer-rgb" ]
            Gtk.ScrolledWindow viewport_scroll {
              hscrollbar-policy: automatic;
              vscrollbar-policy: automatic;
              Gtk.Picture preview_picture {
                can-shrink: true;
                content-fit: contain;
                hexpand: true;
                vexpand: true;
              }
            }
            [overlay]
            Gtk.Box preview_progress {
              orientation: vertical;
              spacing: 6;
              halign: center;
              valign: center;
              width-request: 360;
              styles [ "osd" ]
              Gtk.Label preview_overall_progress_label {
                label: "Overall preview · 0%";
                xalign: 0.0;
                styles [ "caption" ]
              }
              Gtk.ProgressBar preview_progress_bar {
                show-text: true;
                text: "Overall 0%";
                accessibility { label: "Overall preview progress"; }
              }
              Gtk.Label preview_progress_label {
                label: "Preparing preview… · 0%";
                wrap: true;
                justify: center;
                styles [ "heading" ]
              }
              Gtk.ProgressBar preview_stage_progress_bar {
                show-text: true;
                text: "Stage 0%";
                accessibility { label: "Preparing preview stage progress"; }
              }
            }
          };
        }
      }

      Gtk.FlowBox viewport_toolbar {
        selection-mode: none;
        homogeneous: false;
        min-children-per-line: 1;
        max-children-per-line: 3;
        column-spacing: 6;
        row-spacing: 4;
        margin-top: 4;
        margin-bottom: 4;
        margin-start: 8;
        margin-end: 8;
        valign: center;
        styles [ "toniator-viewport-toolbar" ]
        Gtk.Box {
          spacing: 4;
          halign: start;
          valign: center;
          Gtk.Button zoom_out_button {
            icon-name: "zoom-out-symbolic";
            tooltip-text: "Zoom out";
            accessibility { label: "Zoom out"; }
          }
          Gtk.Label zoom_label {
            label: "100%";
            width-chars: 4;
            justify: center;
            accessibility { label: "Zoom level"; }
          }
          Gtk.Button zoom_in_button {
            icon-name: "zoom-in-symbolic";
            tooltip-text: "Zoom in";
            accessibility { label: "Zoom in"; }
          }
          Gtk.ToggleButton fit_button {
            label: "_Fit";
            use-underline: true;
            active: true;
            tooltip-text: "Fit the artwork in the viewport";
          }
        }
      Gtk.Revealer main_banner_revealer {
        transition-type: slide_up;
        transition-duration: 0;
        visible: false;
        Gtk.Box {
          spacing: 6;
          margin-top: 6;
          Gtk.Image { icon-name: "dialog-warning-symbolic"; valign: start; }
          Gtk.ScrolledWindow main_banner_scroll {
            hexpand: true;
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            max-content-height: 96;
            propagate-natural-height: true;
            focusable: true;
            accessibility { label: "Message details"; }
            Gtk.Label main_banner {
              hexpand: true;
              xalign: 0;
              yalign: 0;
              wrap: true;
              wrap-mode: word_char;
              selectable: true;
              max-width-chars: 32;
            }
          }
          Gtk.Button main_banner_dismiss {
            valign: start;
            icon-name: "window-close-symbolic";
            tooltip-text: "Dismiss this message";
            styles [ "flat" ]
            accessibility { label: "Dismiss message"; }
          }
        }
      }
        Gtk.Box toolbar_trailing {
          halign: end;
          spacing: 6;
        Gtk.Box endpoint_controls {
          spacing: 0;
          valign: center;
          visible: false;
          styles [ "linked" ]
          accessibility { label: "Animation endpoint"; }
          Gtk.ToggleButton start_frame_button {
            label: "Start";
            active: true;
            tooltip-text: "Show the start of the selected animation range";
            accessibility { label: "Start frame"; }
          }
          Gtk.ToggleButton end_frame_button {
            label: "End";
            group: start_frame_button;
            tooltip-text: "Show the end of the selected animation range";
            accessibility { label: "End frame"; }
          }
        }
        Gtk.Box view_switcher {
          valign: center;
          spacing: 0;
          styles [ "linked" ]
          Gtk.ToggleButton preview_view_button {
            label: "_Preview";
            use-underline: true;
            active: true;
            tooltip-text: "Show the rendered pattern preview";
          }
          Gtk.ToggleButton source_view_button {
            label: "_Source";
            use-underline: true;
            group: preview_view_button;
            tooltip-text: "Show the original source artwork";
          }
        }
        }
      }

      Gtk.Label end_rotation_warning {
        visible: false;
        label: "Rotating marks can change overlap and tone. The saved calibration stays fixed.";
        xalign: 1;
        wrap: true;
        margin-start: 12;
        margin-end: 12;
        styles [ "dim-label" ]
      }


    }

    Gtk.Box inspector_column {
      orientation: vertical;
      Gtk.Button back_to_canvas {
        margin-top: 10;
        margin-start: 10;
        margin-end: 10;
        label: "_Back to canvas";
        use-underline: true;
        visible: false;
        halign: start;
        tooltip-text: "Return to the canvas (Escape)";
      }

    Gtk.ScrolledWindow inspector_scroll {
      vexpand: true;
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;
      propagate-natural-width: false;
      min-content-width: 0;
      Gtk.Box inspector_content {
        orientation: vertical;
        spacing: 10;
        margin-top: 10;
        margin-bottom: 12;
        margin-start: 10;
        margin-end: 10;
        valign: start;
        styles [ "toniator-inspector" ]
        Gtk.Box color_channel_group {
          orientation: vertical;
          spacing: 8;
          styles [ "toniator-inspector-group" ]
          Gtk.Label { label: "Color & Channel"; xalign: 0; styles [ "heading" ] }
          Gtk.Box {
            spacing: 8;
            Gtk.Label {
              label: "Model";
              xalign: 0;
              hexpand: true;
              mnemonic-widget: model_selector;
            }
            Gtk.DropDown model_selector {
              tooltip-text: "Choose RGB, CMYK, or source color with alpha";
            }
          }
          Gtk.Box {
            spacing: 6;
            Gtk.Label { label: "Edit channel"; xalign: 0; hexpand: true; }
            Gtk.MenuButton channel_help {
              icon-name: "dialog-question-symbolic";
              tooltip-text: "How All and channel editing work";
              accessibility { label: "Edit channel help"; }
              popover: Gtk.Popover {
                Gtk.Label {
                  label: "All assigns the changed setting to every compatible channel, including overrides. At Start, shared Appearance assignments also record the document baseline. Named channels edit only that channel; Reset restores inheritance. Selecting a channel does not isolate the preview.";
                  wrap: true;
                  max-width-chars: 32;
                  selectable: true;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 12;
                  margin-end: 12;
                }
              };
            }
          }
          Gtk.Box channel_segments {
            spacing: 0;
            styles [ "linked", "toniator-channel-segments" ]
            accessibility { label: "Channel to edit"; }
          }
        }

        Gtk.Box inspector_status_row {
          orientation: horizontal;
          spacing: 6;
          valign: center;
          Gtk.Label inspector_status {
            label: "Open artwork to adjust its pattern.";
            xalign: 0;
            wrap: true;
            hexpand: true;
            styles [ "dim-label" ]
          }
          Gtk.Button cancel_pattern_calibration {
            label: "_Cancel";
            use-underline: true;
            visible: false;
            tooltip-text: "Discard the pending Pattern edit and keep the current artwork.";
            accessibility {
              label: "Cancel Pattern calibration";
              description: "Stop preparing the private Pattern edit. The current artwork remains unchanged.";
            }
          }
        }
        Gtk.Box pattern_recipe_group {
          orientation: vertical;
          spacing: 7;
          styles [ "toniator-inspector-group" ]
          Gtk.Label { label: "Pattern Recipe"; xalign: 0; styles [ "heading" ] }
          Gtk.Box inspector_catalog { spacing: 6; }
          Gtk.Expander recipe_details {
            label: "Recipe details";
            accessibility { label: "Recipe details"; }
            expanded: false;
            Gtk.Grid {
            visible: bind recipe_details.expanded;
            column-spacing: 8;
            row-spacing: 3;
            Gtk.Label { label: "Family"; xalign: 0; layout { column: 0; row: 0; } }
            Gtk.Label recipe_family { label: "—"; xalign: 0; hexpand: true; wrap: true; wrap-mode: word_char; layout { column: 1; row: 0; } }
            Gtk.Label { label: "Sites"; xalign: 0; layout { column: 0; row: 1; } }
            Gtk.Label recipe_sites { label: "—"; xalign: 0; hexpand: true; wrap: true; wrap-mode: word_char; layout { column: 1; row: 1; } }
            Gtk.Label { label: "Connections"; xalign: 0; layout { column: 0; row: 2; } }
            Gtk.Label recipe_connections { label: "—"; xalign: 0; hexpand: true; wrap: true; wrap-mode: word_char; layout { column: 1; row: 2; } }
          }
          }
        }

        Gtk.Box appearance_group {
          orientation: vertical;
          spacing: 7;
          styles [ "toniator-inspector-group" ]
          Gtk.Label { label: "Appearance"; xalign: 0; styles [ "heading" ] }
          Gtk.Box appearance_controls { orientation: vertical; spacing: 7; }
        }
        Gtk.Box variation_group {
          orientation: vertical;
          spacing: 7;
          styles [ "toniator-inspector-group" ]
          Gtk.Label { label: "Variation"; xalign: 0; styles [ "heading" ] }
          Gtk.Box variation_controls { orientation: vertical; spacing: 7; }
        }
        Gtk.Box frequent_output_group {
          orientation: vertical;
          spacing: 7;
          styles [ "toniator-inspector-group" ]
          Gtk.Label { label: "Output"; xalign: 0; styles [ "heading" ] }
          Gtk.Box frequent_output_controls { orientation: vertical; spacing: 7; }
        }
        Gtk.Expander options_group {
          label: "Output options";
          accessibility { label: "Output options"; }
          expanded: false;
          styles [ "toniator-inspector-group" ]
          Gtk.Box options_controls { visible: bind options_group.expanded; orientation: vertical; spacing: 7; }
        }
        Gtk.Expander print_preparation_group {
          label: "Print preparation";
          accessibility { label: "Print preparation"; }
          expanded: false;
          styles [ "toniator-inspector-group" ]
          Gtk.Box { visible: bind print_preparation_group.expanded; orientation: vertical; spacing: 7;
          Gtk.Box {
            spacing: 6;
            Gtk.Label print_preparation_summary {
              label: "Unknown size · positive width off · gap width off · Not checked";
              xalign: 0;
              hexpand: true;
              wrap: true;
              selectable: true;
              max-width-chars: 34;
              styles [ "dim-label" ]
            }
            Gtk.Button print_preparation_review {
              label: "Review…";
              tooltip-text: "Review the selected PNG output and physical print settings";
              accessibility { label: "Review print preparation"; }
              styles [ "suggested-action" ]
            }
          }
          Gtk.Expander print_preparation_details {
            label: "Applied settings";
            accessibility { label: "Applied settings"; }
            expanded: false;
            Gtk.Label print_preparation_details_text {
              visible: bind print_preparation_details.expanded;
              label: "Physical dimensions describe the complete output canvas. Positive-feature and gap thresholds are independent; zero disables that check.";
              xalign: 0;
              wrap: true;
              selectable: true;
            }
          }
        }
          }
        Gtk.Label print_attention {
          visible: false;
          wrap: true;
          xalign: 0;
          styles [ "warning" ]
        }
        Gtk.Box advanced_controls {
          orientation: vertical;
          spacing: 7;
        }
      }
    }
    }
  }
}
