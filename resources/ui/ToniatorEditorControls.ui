<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<!-- Static editor controls. Rust owns models, callbacks, help popovers, and custom drawing. -->
<interface>
  <!-- interface-name ToniatorEditorControls.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="editor_controls">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <child>
      <object class="GtkBox" id="source_controls">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox" id="source_dynamic_host">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="artwork_source_label">
            <property name="label">Artwork Source</property>
            <property name="xalign">0</property>
            <style>
              <class name="heading"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkDropDown" id="artwork_source"/>
        </child>
        <child>
          <object class="GtkLabel" id="artwork_source_note">
            <property name="wrap">True</property>
            <property name="xalign">0</property>
            <style>
              <class name="dim-label"/>
              <class name="caption"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="source_alpha_row">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkLabel" id="source_alpha_label">
                <property name="label">Source Alpha</property>
                <property name="xalign">0</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="source_alpha"/>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="source_alpha_note">
            <property name="label">Alpha is the source; source alpha is not applied again.</property>
            <property name="wrap">True</property>
            <property name="xalign">0</property>
            <style>
              <class name="dim-label"/>
              <class name="caption"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="output_controls">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkLabel" id="output_mode_label">
            <property name="label">Output Model</property>
            <property name="xalign">0</property>
            <style>
              <class name="heading"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkDropDown" id="output_mode"/>
        </child>
        <child>
          <object class="GtkLabel" id="channel_assignment_label">
            <property name="label">Channel Assignment</property>
            <property name="xalign">0</property>
            <style>
              <class name="heading"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkDropDown" id="channel_assignment"/>
        </child>
        <child>
          <object class="GtkLabel" id="channel_assignment_note">
            <property name="wrap">True</property>
            <property name="xalign">0</property>
            <style>
              <class name="dim-label"/>
              <class name="caption"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="active_channel_row">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkLabel" id="active_channel_label">
                <property name="label">Active Channel</property>
                <property name="xalign">0</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="active_channel"/>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="crosshatch_action">
            <property name="label">Use Legacy Crosshatch</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="crosshatch_note">
            <property name="label">Legacy Crosshatch temporarily switches to Curves. Exit restores ordinary Curves.</property>
            <property name="wrap">True</property>
            <property name="xalign">0</property>
            <style>
              <class name="dim-label"/>
              <class name="caption"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="appearance_controls">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox" id="preview_section">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkBox" id="preview_heading">
                <property name="orientation">horizontal</property>
                <property name="spacing">4</property>
                <child>
                  <object class="GtkLabel" id="preview_surface_label">
                    <property name="hexpand">True</property>
                    <property name="label">Preview Surface — Canvas only · not exported</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="preview_help_host"/>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="preview_surface"/>
            </child>
            <child>
              <object class="GtkColorDialogButton" id="preview_color"/>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="export_section">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkBox" id="export_heading">
                <property name="orientation">horizontal</property>
                <property name="spacing">4</property>
                <child>
                  <object class="GtkLabel" id="export_background_label">
                    <property name="hexpand">True</property>
                    <property name="label">Export Background — Used for SVG and by default for PNG</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="export_help_host"/>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="export_background"/>
            </child>
            <child>
              <object class="GtkColorDialogButton" id="export_color"/>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="treatment_chrome">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel" id="treatment_title">
            <property name="label">Halftone</property>
            <property name="xalign">0</property>
            <style>
              <class name="title-2"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="treatment_caption">
            <property name="label">Pattern Type</property>
            <property name="xalign">0</property>
            <style>
              <class name="heading"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="treatment_pattern_buttons">
            <property name="spacing">0</property>
            <child>
              <object class="GtkToggleButton" id="dots">
                <property name="hexpand">True</property>
                <property name="label">Shapes</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="squares">
                <property name="label">Squares</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="lines">
                <property name="label">Lines</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="curves">
                <property name="hexpand">True</property>
                <property name="label">Curves</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="legacy">
                <property name="label">Legacy</property>
              </object>
            </child>
            <style>
              <class name="linked"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="treatment_preset_actions">
            <property name="spacing">0</property>
            <child>
              <object class="GtkButton" id="preset_import">
                <property name="hexpand">True</property>
                <property name="label">Load Preset…</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="preset_save">
                <property name="hexpand">True</property>
                <property name="label">Save Preset…</property>
              </object>
            </child>
            <style>
              <class name="linked"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkStack" id="treatment_modes">
            <property name="transition-duration">120</property>
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkBox" id="native_panel">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel" id="native_channel_copy">
                    <property name="label">Automatic CMYK separation</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="heading"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="native_sampling_detail_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkBox" id="native_sampling_detail_heading">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel" id="native_sampling_detail_label">
                            <property name="label">Sampling Detail</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="native_sampling_detail_subtitle">
                            <property name="ellipsize">end</property>
                            <property name="hexpand">True</property>
                            <property name="label">Coarse — Fine</property>
                            <property name="xalign">1</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="native_sampling_detail_control">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkScale" id="native_sampling_detail_scale">
                            <property name="draw-value">False</property>
                            <property name="hexpand">True</property>
                            <property name="orientation">horizontal</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="native_sampling_detail_entry">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Enter an exact value</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="native_coverage_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkBox" id="native_coverage_heading">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel" id="native_coverage_label">
                            <property name="label">Coverage</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="native_coverage_subtitle">
                            <property name="ellipsize">end</property>
                            <property name="hexpand">True</property>
                            <property name="label">How much ink fills the page</property>
                            <property name="xalign">1</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="native_coverage_control">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkScale" id="native_coverage_scale">
                            <property name="draw-value">False</property>
                            <property name="hexpand">True</property>
                            <property name="orientation">horizontal</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="native_coverage_entry">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Enter an exact value</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="native_contrast_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkBox" id="native_contrast_heading">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel" id="native_contrast_label">
                            <property name="label">Contrast</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="native_contrast_subtitle">
                            <property name="ellipsize">end</property>
                            <property name="hexpand">True</property>
                            <property name="label">Separate light and dark areas</property>
                            <property name="xalign">1</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="native_contrast_control">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkScale" id="native_contrast_scale">
                            <property name="draw-value">False</property>
                            <property name="hexpand">True</property>
                            <property name="orientation">horizontal</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="native_contrast_entry">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Enter an exact value</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="native_screen_angle_row">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkBox" id="native_screen_angle_heading">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel" id="native_screen_angle_label">
                            <property name="label">Screen Angle</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="native_screen_angle_subtitle">
                            <property name="ellipsize">end</property>
                            <property name="hexpand">True</property>
                            <property name="label">Rotate square and line screens</property>
                            <property name="xalign">1</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="native_screen_angle_control">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkScale" id="native_screen_angle_scale">
                            <property name="draw-value">False</property>
                            <property name="hexpand">True</property>
                            <property name="orientation">horizontal</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="native_screen_angle_entry">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Enter an exact value</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <style>
                  <class name="workflow-group"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="web_panel_host">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <style><class name="workflow-group"/></style>
                <child><object class="GtkBox" id="web_shared_row"><property name="spacing">4</property><child><object class="GtkCheckButton" id="web_shared"><property name="label">Share Mark Shape Across Inks</property><property name="active">True</property></object></child><child><object class="GtkBox" id="web_shared_help_host"/></child></object></child>
                <child><object class="GtkBox" id="web_shape_row"><property name="orientation">vertical</property><property name="spacing">4</property><child><object class="GtkLabel" id="web_shape_label"><property name="label">Mark</property><property name="xalign">0</property><style><class name="heading"/></style></object></child><child><object class="GtkDropDown" id="web_shape"/></child></object></child>
                <child><object class="GtkLabel" id="web_mixed_shape_label"><property name="label">Mark: Mixed shapes</property><property name="xalign">0</property><property name="visible">False</property><style><class name="heading"/></style></object></child>
                <child><object class="GtkBox" id="web_mixed_shape_apply_row"><property name="orientation">vertical</property><property name="spacing">4</property><property name="visible">False</property><child><object class="GtkLabel" id="web_mixed_shape_apply_label"><property name="label">Apply Mark to All</property><property name="xalign">0</property><style><class name="heading"/></style></object></child><child><object class="GtkDropDown" id="web_mixed_shape_apply"/></child></object></child>
                <child><object class="GtkBox" id="web_polygon_sides_row"><property name="orientation">vertical</property><property name="spacing">4</property><child><object class="GtkBox" id="web_polygon_sides_heading"><property name="spacing">4</property><child><object class="GtkLabel" id="web_polygon_sides_label"><property name="label">Polygon Sides (3–6)</property><property name="xalign">0</property><style><class name="heading"/></style></object></child><child><object class="GtkBox" id="web_polygon_sides_help_host"/></child></object></child><child><object class="GtkSpinButton" id="web_polygon_sides"><property name="numeric">True</property><property name="value">4</property></object></child></object></child>
                <child><object class="GtkBox" id="web_edit_shape_row"><property name="spacing">4</property><child><object class="GtkButton" id="web_edit_shape"><property name="label">Edit User-Defined Mark…</property></object></child><child><object class="GtkBox" id="web_edit_shape_help_host"/></child></object></child>
                <child><object class="GtkLabel" id="web_geometry_note"><property name="xalign">0</property><property name="wrap">True</property><style><class name="dim-label"/><class name="caption"/></style></object></child>
                <child><object class="GtkBox" id="web_target_row"><property name="orientation">vertical</property><property name="spacing">4</property><property name="visible">False</property><child><object class="GtkBox" id="web_target_heading"><property name="spacing">4</property><child><object class="GtkLabel" id="web_target_label"><property name="label">Adjust Ink</property><property name="xalign">0</property><style><class name="heading"/></style></object></child><child><object class="GtkBox" id="web_target_help_host"/></child></object></child><child><object class="GtkDropDown" id="web_target"/></child></object></child>
                <child><object class="GtkLabel" id="web_visible_label"><property name="label">Visible Inks</property><property name="xalign">0</property><style><class name="heading"/></style></object></child>
                <child><object class="GtkBox" id="web_visible_row"><property name="spacing">4</property><child><object class="GtkCheckButton" id="web_visible_c"><property name="label">C</property></object></child><child><object class="GtkCheckButton" id="web_visible_m"><property name="label">M</property></object></child><child><object class="GtkCheckButton" id="web_visible_y"><property name="label">Y</property></object></child><child><object class="GtkCheckButton" id="web_visible_k"><property name="label">K</property></object></child><child><object class="GtkBox" id="web_visible_help_host"/></child></object></child>
                <child><object class="GtkLabel" id="web_mixed"><property name="xalign">0</property><property name="wrap">True</property><style><class name="dim-label"/><class name="caption"/></style></object></child>
                <child><object class="GtkBox" id="web_color_row"><property name="orientation">vertical</property><property name="spacing">4</property><child><object class="GtkBox" id="web_color_heading_row"><property name="spacing">4</property><child><object class="GtkLabel" id="web_color_heading"><property name="label">Ink Color</property><property name="xalign">0</property><style><class name="heading"/></style></object></child><child><object class="GtkBox" id="web_color_help_host"/></child></object></child><child><object class="GtkBox" id="web_color_control"><property name="spacing">8</property><child><object class="GtkEntry" id="web_color"><property name="placeholder-text">#RRGGBB</property></object></child><child><object class="GtkLabel" id="web_color_status"><property name="label">Hex color</property><property name="xalign">1</property><property name="hexpand">True</property><style><class name="dim-label"/><class name="caption"/></style></object></child></object></child></object></child>
                <child><object class="GtkBox" id="web_crosshatch_color_row"><property name="orientation">vertical</property><property name="spacing">4</property><property name="visible">False</property><child><object class="GtkLabel" id="web_crosshatch_color_label"><property name="label">Crosshatch Color</property><property name="xalign">0</property><style><class name="heading"/></style></object></child><child><object class="GtkBox" id="web_crosshatch_color_control"><property name="spacing">8</property><child><object class="GtkEntry" id="web_crosshatch_color"><property name="placeholder-text">#111111</property></object></child><child><object class="GtkLabel" id="web_crosshatch_color_status"><property name="label">Hex color</property><property name="xalign">1</property><property name="hexpand">True</property><style><class name="dim-label"/><class name="caption"/></style></object></child></object></child></object></child>
