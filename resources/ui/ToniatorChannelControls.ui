<?xml version='1.0' encoding='UTF-8'?>
<!-- Reused for one real OutputChannelId only; no aggregate channel exists here. -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="channel_controls">
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>
    <child>
      <object class="GtkLabel" id="channel_heading">
        <property name="xalign">0</property>
        <style><class name="heading"/></style>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="channel_inclusion_status">
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <style><class name="dim-label"/><class name="caption"/></style>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="channel_content_host">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
      </object>
    </child>
  </object>
</interface>
