using Gtk 4.0;

Box channel_controls {
  orientation: vertical;
  spacing: 6;

  Label channel_heading {
    xalign: 0;

    styles [
      "heading",
    ]
  }

  Label channel_inclusion_status {
    wrap: true;
    xalign: 0;

    styles [
      "dim-label",
      "caption",
    ]
  }

  Box channel_point_sampler_row {
    spacing: 8;
    Label channel_point_sampler_label {
      hexpand: true;
      label: "Point sampler";
      xalign: 0;
    }
    DropDown channel_point_sampler {}
  }

  Box channel_random_seed_row {
    spacing: 8;
    Label channel_random_seed_label {
      hexpand: true;
      label: "Random seed";
      xalign: 0;
    }
    SpinButton channel_random_seed { numeric: true; }
  }

  Box channel_weight_influence_row {
    spacing: 8;
    Label channel_weight_influence_label {
      hexpand: true;
      label: "Weight influence";
      xalign: 0;
    }
    SpinButton channel_weight_influence { numeric: true; }
  }

  Box channel_content_host {
    orientation: vertical;
    spacing: 4;
  }
}
