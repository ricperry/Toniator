                                            ]
                                          }
                                        }
                          
                                        Box curve_detail_control {
                                          spacing: 8;
                          
                                          Scale curve_detail_scale {
                                            orientation: horizontal;
                                            draw-value: false;
                                            hexpand: true;
                                          }
                          
                                          SpinButton curve_detail_entry {
                                            numeric: true;
                                            tooltip-text: "Enter an exact value";
                                          }
                                        }
                                      }
                          
                                      Box curve_close_ends_row {
                                        spacing: 4;
                          
                                        CheckButton curve_close_ends {
                                          label: "Close Ends";
                                        }
                                      }
                          
                                      Box curve_smooth_join_row {
                                        spacing: 4;
                          
                                        CheckButton curve_smooth_join {
                                          label: "Smooth Join";
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                        }
                      }
                    }
                  }
                }
              }
            }

            [content]
            Box canvas_box {
              orientation: vertical;
              hexpand: true;
              vexpand: true;

              ScrolledWindow canvas {
                hexpand: true;
                vexpand: true;
                hscrollbar-policy: automatic;
                vscrollbar-policy: automatic;
                css-classes: ["canvas"];

                Box canvas_stage_host {
                  hexpand: true;
                  vexpand: true;

                  Overlay canvas_content {
                    halign: center;
                    valign: center;

                    Picture picture {
                      content-fit: contain;
                      can-shrink: true;
                      hexpand: true;
                      vexpand: true;
                      css-classes: ["artboard"];
                    }

                    [overlay]
                    DrawingArea motif_overlay {
                      hexpand: true;
                      vexpand: true;
                      focusable: true;
                      can-target: true;
                      visible: false;
                    }
                  }
                }

              }

              Box status_row {
                spacing: 6;
                margin-start: 12;
                margin-end: 12;

                Label workspace_status {
                  label: "Preview will appear here";
                  xalign: 0;
                  ellipsize: end;
                  hexpand: true;
                  css-classes: ["caption", "dim-label", "workspace-status"];
                }

                Button cancel_preview {
                  label: "Cancel Preview";
                  visible: false;
                }

                Button cancel_export {
                  label: "Cancel Export";
                  visible: false;
                }
              }

              Box canvas_controls {
                spacing: 8;
                margin-top: 8;
                margin-bottom: 8;
                margin-start: 12;
                margin-end: 12;

                ToggleButton fit {
                  label: "Fit";
                  css-classes: ["flat"];
                }

                Button zoom_out {
                  icon-name: "zoom-out-symbolic";
                  tooltip-text: "Zoom out 25 percentage points";
                }

                Scale zoom {
                  orientation: horizontal;
                  draw-value: false;
                  hexpand: true;
                  width-request: 80;
                }

                Entry zoom_entry {
                  text: "100";
                  width-chars: 4;
                  max-width-chars: 5;
                  width-request: 7;
                }

                Label zoom_percent {
                  label: "%";
                }

                Button zoom_in {
                  icon-name: "zoom-in-symbolic";
                  tooltip-text: "Zoom in 25 percentage points";
                }

                Separator zoom_separator {
                  orientation: vertical;
                }

                Box view_switch {
                  spacing: 0;
                  css-classes: ["linked"];

                  ToggleButton rendered_view {
                    label: "Halftone";
                    active: true;
                  }

                  ToggleButton compare {
                    label: "Source";
                  }
                }

                Box canvas_controls_spacer {
                  hexpand: true;
                }

                Box preview_indicator_host {}
              }
            }
          }
        }
      }
    }
  }
}
