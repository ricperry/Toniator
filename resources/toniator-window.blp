using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow main_window {
  title: "Toniator";

  Adw.ToolbarView main_toolbar_view {
    [top]
    Adw.HeaderBar main_header_bar {
      [title]
      Adw.WindowTitle window_title {
        subtitle: "Start a project";
        title: "Toniator";
      }

      [start]
      Button new_project_button {
        label: "New";
        tooltip-text: "Start a new project";
      }

      [start]
      Button open_button {
        label: "Open";
        tooltip-text: "Open artwork or document";
      }

      [start]
      Button save_button {
        label: "Save";
        tooltip-text: "Save Toniator document";
      }

      [start]
      Button undo_button {
        icon-name: "edit-undo-symbolic";
        tooltip-text: "Undo";
      }

      [start]
      Button redo_button {
        icon-name: "edit-redo-symbolic";
        tooltip-text: "Redo";
      }

      [start]
      ToggleButton controls_toggle {
        active: true;
        label: "Controls";
        tooltip-text: "Hide Controls";
      }

      [end]
      Button export_button {
        label: "Export…";
        tooltip-text: "Export editable SVG or PNG image";
      }
    }

    Adw.ToastOverlay toast_overlay {
      Stack main_stack {
        transition-duration: 180;
        transition-type: crossfade;

        ScrolledWindow start_page {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;

          Box start_content {
            orientation: vertical;
            spacing: 18;
            halign: center;
            valign: center;
            margin-start: 32;
            margin-end: 32;

            Box start_hero_frame {
              width-request: 520;
              height-request: 240;
              halign: center;
              valign: start;
              hexpand: false;
              vexpand: false;
              overflow: hidden;

              Picture start_hero {
                content-fit: contain;
                can-shrink: true;
                hexpand: true;
                vexpand: true;
              }
            }

            Label start_title {
              label: "Turn artwork into print-ready halftones";
              css-classes: ["title-1"];
              wrap: true;
              justify: center;
            }

            Label start_subtitle {
              label: "Start with a useful result, then shape the halftone to fit your work.";
              css-classes: ["dim-label", "title-4"];
              wrap: true;
              justify: center;
            }

            Box start_actions {
              spacing: 10;
              halign: center;

              Button open_artwork {
                label: "Open Artwork";
                css-classes: ["suggested-action", "pill"];
              }

              Button open_document {
                label: "Open Toniator Document";
                css-classes: ["pill"];
              }
            }

            Button try_example {
              label: "Try Example";
              css-classes: ["flat"];
            }

            Box start_recovery_host {
              orientation: vertical;
              spacing: 8;
              halign: center;
            }
          }
        }

        Box editor_page {
          Adw.OverlaySplitView editor_split_view {
            sidebar-position: start;
            collapsed: false;
            show-sidebar: true;
            sidebar-width-unit: px;
            sidebar-width-fraction: 0.4;
            min-sidebar-width: 340;
            max-sidebar-width: 640;

            [sidebar]
            Box inspector_shell {
              orientation: vertical;
              vexpand: true;
              css-classes: ["inspector-shell"];

              Label editing_context {
                label: "Shapes · All inks";
                xalign: 0;
                wrap: true;
                css-classes: ["caption", "editing-context"];
              }

              ScrolledWindow inspector_scroll {
                vexpand: true;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;
                min-content-width: 340;
                css-classes: ["inspector-pane"];

                Box inspector_content {
                  orientation: vertical;
                  spacing: 14;
                  margin-top: 18;
                  margin-bottom: 18;
                  margin-start: 18;
                  margin-end: 18;
                  css-classes: ["inspector"];

                  Box editor_controls {
                    orientation: vertical;
                    spacing: 8;

                    Box editor_inspector_hierarchy {
                      orientation: vertical;
                      spacing: 8;

                      Expander source_section {
                        expanded: true;
                        label: "Source";

                        Box source_content_host {
                          margin-top: 10;
                          orientation: vertical;
                          spacing: 6;
  Box source_controls {
                              orientation: vertical;
                              spacing: 6;
                          
                          Box source_dynamic_host {
                            orientation: vertical;
                            spacing: 4;

                            Label source_label {
                              xalign: 0;
                              ellipsize: middle;
                            }

                            Label autosave_status {
                              xalign: 0;
                              wrap: true;
                              styles [
                                "dim-label",
                                "caption",
                              ]
                            }
                          }
                          
                              Label artwork_source_label {
                                label: "Artwork Source";
                                xalign: 0;
                          
                                styles [
                                  "heading",
                                ]
                              }
                          
                              DropDown artwork_source {}
                          
                              Label artwork_source_note {
                                wrap: true;
                                xalign: 0;
                          
                                styles [
                                  "dim-label",
                                  "caption",
                                ]
                              }
                          
                              Box source_alpha_row {
                                orientation: vertical;
                                spacing: 4;
                          
                                Label source_alpha_label {
                                  label: "Source Alpha";
                                  xalign: 0;
                          
                                  styles [
                                    "heading",
                                  ]
                                }
                          
                                DropDown source_alpha {}
                              }
                          
                              Label source_alpha_note {
                                label: "Alpha is the source; source alpha is not applied again.";
                                wrap: true;
                                xalign: 0;
                          
                                styles [
                                  "dim-label",
                                  "caption",
                                ]
                              }
                            }
                        }
                      }

                      Expander output_section {
                        expanded: true;
                        label: "Output";

                        Box output_content_host {
                          margin-top: 10;
                          orientation: vertical;
                          spacing: 6;
  Box output_controls {
                              orientation: vertical;
                              spacing: 6;
                          
                              Label output_mode_label {
                                label: "Output Model";
                                xalign: 0;
                          
                                styles [
                                  "heading",
                                ]
                              }
                          
                              DropDown output_mode {}
                          
                              Label channel_assignment_label {
                                label: "Channel Assignment";
                                xalign: 0;
                          
                                styles [
                                  "heading",
                                ]
                              }
                          
                              DropDown channel_assignment {}
                          
                              Label channel_assignment_note {
                                wrap: true;
                                xalign: 0;
                          
                                styles [
                                  "dim-label",
                                  "caption",
                                ]
                              }
                          
                              Box active_channel_row {
                                orientation: vertical;
                                spacing: 4;
                          
                                Label active_channel_label {
                                  label: "Active Channel";
                                  xalign: 0;
                          
                                  styles [
                                    "heading",
                                  ]
                                }
                          
                                DropDown active_channel {}
                              }
                          
                              Button crosshatch_action {
                                label: "Use Legacy Crosshatch";
                              }
                          
                              Label crosshatch_note {
                                label: "Legacy Crosshatch temporarily switches to Curves. Exit restores ordinary Curves.";
                                wrap: true;
                                xalign: 0;
                          
                                styles [
                                  "dim-label",
                                  "caption",
                                ]
                              }
                            }
                        }
                      }

                      Expander channel_settings_section {
                        expanded: false;
                        label: "Channel Settings";

                        Box channel_settings_content_host {
                          margin-top: 10;
                          orientation: vertical;
                          spacing: 8;

                          Label channel_scope_heading {
                            label: "Treatment Editing Scope";
                            xalign: 0;
                            styles [
                              "heading",
                            ]
                          }

                          Label channel_scope_note {
                            label: "Choose the inks or channels edited by Shapes and Curves. Output routing remains in Output.";
                            wrap: true;
                            xalign: 0;
                            styles [
                              "dim-label",
                              "caption",
                            ]
                          }

                          Box channel_scope_host {
                            orientation: vertical;
                            spacing: 4;

                            DropDown channel_scope {}
                          }

                          Stack channel_panel_stack {
                            transition-duration: 120;
                            transition-type: crossfade;
                          }
                        }
                      }

                      Expander appearance_section {
                        expanded: false;
                        label: "Appearance / Canvas & Export";
                        overflow: hidden;

                        Box appearance_content_host {
                          margin-top: 10;
                          orientation: vertical;
                          spacing: 8;
  Box appearance_controls {
                              orientation: vertical;
                              spacing: 8;
                          
                              Box preview_section {
                                orientation: vertical;
                                spacing: 4;
                          
                                Box preview_heading {
                                  orientation: horizontal;
                                  spacing: 4;
                          
                                  Label preview_surface_label {
                                    hexpand: true;
                                    label: "Preview Surface — Canvas only · not exported";
                                    xalign: 0;
                                  }
                          
                                  Box preview_help_host {}
                                }
                          
                                DropDown preview_surface {}
                          
                                ColorDialogButton preview_color {}
                              }
                          
                              Box export_section {
                                orientation: vertical;
                                spacing: 4;
                          
                                Box export_heading {
                                  orientation: horizontal;
                                  spacing: 4;
                          
                                  Label export_background_label {
                                    hexpand: true;
                                    label: "Export Background — Used for SVG and by default for PNG";
                                    xalign: 0;
                                  }
                          
                                  Box export_help_host {}
                                }
                          
                                DropDown export_background {}
                          
                                Box export_color_row {
                                  orientation: horizontal;
                                  spacing: 8;

                                  Label export_color_label {
                                    hexpand: true;
                                    label: "Background Color · None (transparent)";
                                    xalign: 0;
                                  }

                                  ColorDialogButton export_color {}
                                }
                              }
                            }
                        }
                      }

                      Expander treatment_section {
                        expanded: false;
                        label: "Treatment Settings";

                        Box treatment_content_host {
                          margin-top: 10;
                          orientation: vertical;
                          spacing: 8;
  Box treatment_chrome {
                              orientation: vertical;
                              spacing: 8;
                          
                              Label treatment_title {
                                label: "Halftone";
                                xalign: 0;
                          
                                styles [
                                  "title-2",
                                ]
                              }
                          
                              Label treatment_caption {
                                label: "Pattern Type";
                                xalign: 0;
                          
                                styles [
                                  "heading",
                                ]
                              }
                          
                              Box treatment_pattern_buttons {
                                spacing: 0;
                          
                                ToggleButton dots {
                                  hexpand: true;
                                  label: "Shapes";
                                }
                          
                                ToggleButton squares {
                                  label: "Squares";
                                }
                          
                                ToggleButton lines {
                                  label: "Lines";
                                }
                          
                                ToggleButton curves {
                                  hexpand: true;
                                  label: "Curves";
                                }
                          
                                ToggleButton legacy {
                                  label: "Legacy";
                                }
                          
                                styles [
                                  "linked",
                                ]
                              }
                          
                              Box treatment_preset_actions {
                                spacing: 0;
                          
                                Button preset_import {
                                  hexpand: true;
                                  label: "Load Preset…";
                                }
                          
                                Button preset_save {
                                  hexpand: true;
                                  label: "Save Preset…";
                                }
                          
                                styles [
                                  "linked",
                                ]
                              }
                          
                              Stack treatment_modes {
                                transition-duration: 120;
                                transition-type: crossfade;
                          
                                Box native_panel {
                                  orientation: vertical;
                                  spacing: 12;
                          
                                  Label native_channel_copy {
                                    label: "Automatic CMYK separation";
                                    xalign: 0;
                          
                                    styles [
                                      "heading",
                                    ]
                                  }
                          
                                  Box native_sampling_detail_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box native_sampling_detail_heading {
                                      spacing: 8;
                          
                                      Label native_sampling_detail_label {
                                        label: "Sampling Detail";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Label native_sampling_detail_subtitle {
                                        ellipsize: end;
                                        hexpand: true;
                                        label: "Coarse — Fine";
                                        xalign: 1;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                          
                                    Box native_sampling_detail_control {
                                      spacing: 8;
                          
                                      Scale native_sampling_detail_scale {
                                        draw-value: false;
                                        hexpand: true;
                                        orientation: horizontal;
                                      }
                          
                                      SpinButton native_sampling_detail_entry {
                                        numeric: true;
                                        tooltip-text: "Enter an exact value";
                                      }
                                    }
                                  }
                          
                                  Box native_coverage_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box native_coverage_heading {
                                      spacing: 8;
                          
                                      Label native_coverage_label {
                                        label: "Coverage";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Label native_coverage_subtitle {
                                        ellipsize: end;
                                        hexpand: true;
                                        label: "How much ink fills the page";
                                        xalign: 1;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                          
                                    Box native_coverage_control {
                                      spacing: 8;
                          
                                      Scale native_coverage_scale {
                                        draw-value: false;
                                        hexpand: true;
                                        orientation: horizontal;
                                      }
                          
                                      SpinButton native_coverage_entry {
                                        numeric: true;
                                        tooltip-text: "Enter an exact value";
                                      }
                                    }
                                  }
                          
                                  Box native_contrast_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box native_contrast_heading {
                                      spacing: 8;
                          
                                      Label native_contrast_label {
                                        label: "Contrast";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Label native_contrast_subtitle {
                                        ellipsize: end;
                                        hexpand: true;
                                        label: "Separate light and dark areas";
                                        xalign: 1;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                          
                                    Box native_contrast_control {
                                      spacing: 8;
                          
                                      Scale native_contrast_scale {
                                        draw-value: false;
                                        hexpand: true;
                                        orientation: horizontal;
                                      }
                          
                                      SpinButton native_contrast_entry {
                                        numeric: true;
                                        tooltip-text: "Enter an exact value";
                                      }
                                    }
                                  }
                          
                                  Box native_screen_angle_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box native_screen_angle_heading {
                                      spacing: 8;
                          
                                      Label native_screen_angle_label {
                                        label: "Screen Angle";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Label native_screen_angle_subtitle {
                                        ellipsize: end;
                                        hexpand: true;
                                        label: "Rotate square and line screens";
                                        xalign: 1;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                          
                                    Box native_screen_angle_control {
                                      spacing: 8;
                          
                                      Scale native_screen_angle_scale {
                                        draw-value: false;
                                        hexpand: true;
                                        orientation: horizontal;
                                      }
                          
                                      SpinButton native_screen_angle_entry {
                                        numeric: true;
                                        tooltip-text: "Enter an exact value";
                                      }
                                    }
                                  }
                          
                                  styles [
                                    "workflow-group",
                                  ]
                                }
                          
                                Box web_panel_host {
                                  orientation: vertical;
                                  spacing: 10;
                          
                                  styles [
                                    "workflow-group",
                                  ]
                          
                                  Box web_shared_row {
                                    spacing: 4;
                          
                                    CheckButton web_shared {
                                      label: "Share Mark Shape Across Inks";
                                      active: true;
                                    }
                          
                                    Box web_shared_help_host {}
                                  }
                          
                                  Box web_shape_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Label web_shape_label {
                                      label: "Mark";
                                      xalign: 0;
                          
                                      styles [
                                        "heading",
                                      ]
                                    }
                          
                                    DropDown web_shape {}
                                  }
                          
                                  Label web_mixed_shape_label {
                                    label: "Mark: Mixed shapes";
                                    xalign: 0;
                                    visible: false;
                          
                                    styles [
                                      "heading",
                                    ]
                                  }
                          
                                  Box web_mixed_shape_apply_row {
                                    orientation: vertical;
                                    spacing: 4;
                                    visible: false;
                          
                                    Label web_mixed_shape_apply_label {
                                      label: "Apply Mark to All";
                                      xalign: 0;
                          
                                      styles [
                                        "heading",
                                      ]
                                    }
                          
                                    DropDown web_mixed_shape_apply {}
                                  }
                          
                                  Box web_polygon_sides_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box web_polygon_sides_heading {
                                      spacing: 4;
                          
                                      Label web_polygon_sides_label {
                                        label: "Polygon Sides (3–6)";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Box web_polygon_sides_help_host {}
                                    }
                          
                                    SpinButton web_polygon_sides {
                                      numeric: true;
                                      value: 4;
                                    }
                                  }
                          
                                  Box web_edit_shape_row {
                                    spacing: 4;
                          
                                    Button web_edit_shape {
                                      label: "Edit User-Defined Mark…";
                                    }
                          
                                    Box web_edit_shape_help_host {}
                                  }
                          
                                  Label web_geometry_note {
                                    xalign: 0;
                                    wrap: true;
                          
                                    styles [
                                      "dim-label",
                                      "caption",
                                    ]
                                  }
                          
                                  Box web_target_row {
                                    orientation: vertical;
                                    spacing: 4;
                                    visible: false;
                          
                                    Box web_target_heading {
                                      spacing: 4;
                          
                                      Label web_target_label {
                                        label: "Adjust Ink";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Box web_target_help_host {}
                                    }
                          
                                    DropDown web_target {}
                                  }
                          
                                  Label web_visible_label {
                                    label: "Visible Inks";
                                    xalign: 0;
                          
                                    styles [
                                      "heading",
                                    ]
                                  }
                          
                                  Box web_visible_row {
                                    spacing: 4;
                          
                                    CheckButton web_visible_c {
                                      label: "C";
                                    }
                          
                                    CheckButton web_visible_m {
                                      label: "M";
                                    }
                          
                                    CheckButton web_visible_y {
                                      label: "Y";
                                    }
                          
                                    CheckButton web_visible_k {
                                      label: "K";
                                    }
                          
                                    Box web_visible_help_host {}
                                  }
                          
                                  Label web_mixed {
                                    xalign: 0;
                                    wrap: true;
                          
                                    styles [
                                      "dim-label",
                                      "caption",
                                    ]
                                  }
                          
                                  Box web_color_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box web_color_heading_row {
                                      spacing: 4;
                          
                                      Label web_color_heading {
                                        label: "Ink Color";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Box web_color_help_host {}
                                    }
                          
                                    Box web_color_control {
                                      spacing: 8;
                          
                                      Entry web_color {
                                        placeholder-text: "#RRGGBB";
                                      }
                          
                                      Label web_color_status {
                                        label: "Hex color";
                                        xalign: 1;
                                        hexpand: true;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                                  }
                          
                                  Box web_crosshatch_color_row {
                                    orientation: vertical;
                                    spacing: 4;
                                    visible: false;
                          
                                    Label web_crosshatch_color_label {
                                      label: "Crosshatch Color";
                                      xalign: 0;
                          
                                      styles [
                                        "heading",
                                      ]
                                    }
                          
                                    Box web_crosshatch_color_control {
                                      spacing: 8;
                          
                                      Entry web_crosshatch_color {
                                        placeholder-text: "#111111";
                                      }
                          
                                      Label web_crosshatch_color_status {
                                        label: "Hex color";
                                        xalign: 1;
                                        hexpand: true;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                                  }
                          
                                  Box web_coverage_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box web_coverage_heading {
                                      spacing: 8;
                          
                                      Label web_coverage_label {
                                        label: "Coverage";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Label web_coverage_status {
                                        label: "Mark size";
                                        xalign: 1;
                                        hexpand: true;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                          
                                    Box web_coverage_control {
                                      spacing: 8;
                          
                                      Scale web_coverage_scale {
                                        orientation: horizontal;
                                        draw-value: false;
                                        hexpand: true;
                                      }
                          
                                      SpinButton web_coverage_entry {
                                        numeric: true;
                                        tooltip-text: "Enter an exact value";
                                      }
                                    }
                                  }
                          
                                  Box web_angle_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box web_angle_heading {
                                      spacing: 8;
                          
                                      Label web_angle_label {
                                        label: "Screen Angle";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Label web_angle_status {
                                        label: "Rotate sampling grid";
                                        xalign: 1;
                                        hexpand: true;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                          
                                    Box web_angle_control {
                                      spacing: 8;
                          
                                      Scale web_angle_scale {
                                        orientation: horizontal;
                                        draw-value: false;
                                        hexpand: true;
                                      }
                          
                                      SpinButton web_angle_entry {
                                        numeric: true;
                                        tooltip-text: "Enter an exact value";
                                      }
                                    }
                                  }
                          
                                  Box web_mark_angle_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box web_mark_angle_heading {
                                      spacing: 8;
                          
                                      Label web_mark_angle_label {
                                        label: "Mark Rotation";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
                                      Label web_mark_angle_status {
                                        label: "Rotate marks within the grid";
                                        xalign: 1;
                                        hexpand: true;
                          
                                        styles [
                                          "dim-label",
                                          "caption",
                                        ]
                                      }
                                    }
                          
                                    Box web_mark_angle_control {
                                      spacing: 8;
                          
                                      Scale web_mark_angle_scale {
                                        orientation: horizontal;
                                        draw-value: false;
                                        hexpand: true;
                                      }
                          
                                      SpinButton web_mark_angle_entry {
                                        numeric: true;
                                        tooltip-text: "Enter an exact value";
                                      }
                                    }
                                  }
                          
                                  Box web_width_scale_row {
                                    orientation: vertical;
                                    spacing: 4;
                          
                                    Box web_width_scale_heading {
                                      spacing: 8;
                          
                                      Label web_width_scale_label {
                                        label: "Mark Width";
                                        xalign: 0;
                          
                                        styles [
                                          "heading",
                                        ]
                                      }
                          
